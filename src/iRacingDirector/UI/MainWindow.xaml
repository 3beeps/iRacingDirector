<Window x:Class="IRacingDirector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IRacingDirector.Core"
        xmlns:svc="clr-namespace:IRacingDirector.Services"
        Title="iRacing Director" Width="1040" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/director.ico"
        Style="{StaticResource DarkWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="/Assets/director.ico" Width="30" Height="30" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="iRacing Director" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11">
                            <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ElevationText}" TextWrapping="Wrap" Margin="4,0" FontSize="11" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" />
                            <TextBlock Text="Apps" Margin="12,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                            <TextBlock Text="Activity" Margin="12,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                            <TextBlock Text="Settings" Margin="12,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="24,20,24,20">

            <!-- Update banner -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="16,10" CornerRadius="8" Cursor="Hand"
                    Background="{StaticResource AccentBrush}" MouseLeftButtonUp="UpdateBanner_Click"
                    Visibility="{Binding Updates.IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Install update">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0" Text="{Binding Updates.BannerText}" Foreground="White"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="Install update" Foreground="White" VerticalAlignment="Center"
                               TextDecorations="Underline" />
                </Grid>
            </Border>

            <!-- Status header -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,18" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Director.State}" Value="{x:Static core:SessionState.InSession}">
                                        <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Director.State}" Value="{x:Static core:SessionState.Ending}">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Director.StatusText}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoMode}"
                                      ToolTip="Start apps when the sim starts and close them when it exits">
                                <TextBlock Style="{StaticResource Muted}" Text="Automatic mode" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding SessionDuration}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Click="LaunchIRacing_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
                                <TextBlock Text="Launch iRacing" />
                            </StackPanel>
                        </Button>
                        <Button Click="StartApps_Click" Margin="0,0,8,0" ToolTip="Start every app set to start with a session">
                            <TextBlock Text="Start apps" />
                        </Button>
                        <Button Click="CloseApps_Click" ToolTip="Close every app set to close with a session">
                            <TextBlock Text="Close apps" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <!-- ============ Apps page ============ -->
                <DockPanel Visibility="{Binding IsChecked, ElementName=NavApps, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Support apps" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Started in this order when the sim starts, closed in reverse when it exits." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="FindApps_Click" Margin="0,0,8,0" ToolTip="Look for sim racing apps on this PC that aren't added yet">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                                    <TextBlock Text="Find apps" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddAppButton" AutomationProperties.Name="Add app" Style="{StaticResource PrimaryButton}" Click="AddApp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <TextBlock Text="Add app" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="16,0,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="196" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="Auto start" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="Auto close" />
                    </Grid>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:AppEntry}">
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="1" Source="{Binding Path, Converter={StaticResource PathToIcon}}" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center" />

                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
                                                            <Setter Property="ToolTip" Value="Not running" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                                                    <Setter Property="ToolTip" Value="Running" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PathExists}" Value="False">
                                                                    <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                                                    <Setter Property="ToolTip" Value="File not found. Edit the app to fix its path." />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource WarnBrush}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                                </StackPanel>

                                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding StartWithSession}" ToolTip="Start when the sim starts" />
                                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding StopWithSession}" ToolTip="Close when the sim exits" />

                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Click="LaunchApp_Click" ToolTip="Start now">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="CloseApp_Click" ToolTip="Close now">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="MoveUp_Click" ToolTip="Move up">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="MoveDown_Click" ToolTip="Move down">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="EditApp_Click" ToolTip="Edit">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="RemoveApp_Click" ToolTip="Remove">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="EmptyState">
                            <TextBlock Text="No apps yet" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Text="Add SimHub, Crew Chief, overlays, anything you run with iRacing." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Find my apps" HorizontalAlignment="Center" Margin="0,16,0,0" Click="FindApps_Click" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- ============ Activity page ============ -->
                <DockPanel Visibility="{Binding IsChecked, ElementName=NavActivity, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Activity" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Everything Director has done, newest first." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenLogFolder_Click">
                            <TextBlock Text="Open log folder" />
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="10,5" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:LogEntry}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontFamily="Consolas" />
                                        <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Success}">
                                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Warning}">
                                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Error}">
                                                            <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- ============ Settings page ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,14" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Automation" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoMode}" Content="Start and close apps automatically with the sim" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Wait before closing apps (seconds)" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0"
                                                   Text="After the sim exits, apps stay open this long. If you join another session in time, nothing gets closed." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.SessionEndDelaySeconds}" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Force-close after (seconds)" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0"
                                                   Text="Apps are asked to close nicely first. Anything still running after this long is force-closed." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.CloseGraceSeconds}" />
                                </Grid>

                                <CheckBox Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding Settings.OnlyCloseAppsDirectorStarted}">
                                    <StackPanel>
                                        <TextBlock Text="Only auto-close apps that Director started" />
                                        <TextBlock Style="{StaticResource Muted}" Text="Leaves apps alone if you opened them yourself before the session." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Windows" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.StartWithWindows}" Content="Start iRacing Director when I sign in" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding Settings.StartMinimizedToTray}" Content="When started with Windows, stay in the tray" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding Settings.CloseToTray}" Content="Closing the window keeps Director running in the tray" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding Settings.RunAsAdmin}">
                                    <StackPanel>
                                        <TextBlock Text="Run as administrator" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Needed to close apps that run as administrator (like SimHub). With 'Start when I sign in' there's no UAC prompt." />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ElevationText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding Settings.CheckForUpdates}">
                                    <StackPanel>
                                        <TextBlock Text="Check for updates automatically" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Looks for a new version on GitHub when Director starts and once a day. Nothing installs until you click the banner." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="iRacing" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <TextBlock Text="iRacing UI" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Settings.IRacingUiPath}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Click="BrowseUi_Click" Content="Browse" />
                                </Grid>
                                <TextBlock Text="Sim process name" Margin="0,14,0,6" />
                                <TextBox Text="{Binding Settings.SimProcessName}" HorizontalAlignment="Left" Width="260" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="A session counts as started while this process runs. Default: iRacingSim64DX11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
