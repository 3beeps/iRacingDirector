<Window x:Class="IRacingDirector.UI.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit app" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">
    <StackPanel Margin="22">
        <TextBlock Text="Name" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Program" Margin="0,14,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Click="Browse_Click" />
        </Grid>

        <TextBlock Text="Arguments (optional)" Margin="0,14,0,6" />
        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Extra process names (optional)" Margin="0,14,0,6" />
        <TextBox Text="{Binding ExtraProcessNames, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="For apps whose launcher starts a differently named program. Comma separated, * wildcards allowed, e.g. garage61-agent*" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Start delay (seconds)" />
                <TextBlock Style="{StaticResource Muted}" Text="Wait this long before starting this app." />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding StartDelaySeconds}" />
        </Grid>

        <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding StartWithSession}" Content="Start when the sim starts" />
        <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding StopWithSession}" Content="Close when the sim exits" />
        <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding StartMinimized}" Content="Start minimized (if the app supports it)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
