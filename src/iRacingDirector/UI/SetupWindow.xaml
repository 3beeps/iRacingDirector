<Window x:Class="IRacingDirector.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:IRacingDirector.UI"
        Title="iRacing Director setup" Width="680" Height="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/director.ico"
        Style="{StaticResource DarkWindow}">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/director.ico" Width="36" Height="36" />
                <TextBlock x:Name="Heading" Text="Welcome to iRacing Director" Style="{StaticResource H1}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Intro" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Pick the apps you want started when you join an iRacing session. Director closes them again when you're done. You can change this any time." />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10" x:Name="IRacingCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IRacingIcon" Style="{StaticResource Icon}" FontSize="16" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock x:Name="IRacingTitle" Text="Found iRacing" FontWeight="SemiBold" />
                        <TextBlock x:Name="IRacingPath" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Change" Click="BrowseIRacing_Click" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,8">
                <TextBlock Text="Your apps" Style="{StaticResource H2}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Click="AddOther_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Add another app" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="OptionsCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Switch}" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Start iRacing Director when I sign in" />
                            <TextBlock Style="{StaticResource Muted}" Text="It waits quietly in the tray until you race." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AdminBox" Style="{StaticResource Switch}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Run as administrator" />
                            <TextBlock x:Name="AdminHint" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Turn this on if any of your apps run as administrator (like SimHub), or Director can't close them." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Skip for now" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="FinishButton" Content="Finish setup" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Finish_Click" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:SetupItem}">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected}" />
                                    <Image Grid.Column="1" Source="{Binding Path, Converter={StaticResource PathToIcon}}" Width="24" Height="24" Margin="4,0,12,0" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="ListMessage" Text="Looking for your sim racing apps…" Style="{StaticResource Muted}" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
