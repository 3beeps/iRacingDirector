<Window x:Class="IRacingDirector.UI.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:IRacingDirector.Services"
        Title="Add an app" Width="560" Height="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Which app should start with iRacing?" Style="{StaticResource H2}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" Text="These are the programs in your Start Menu. Can't see it? Browse for the file." />
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Search programs" />
                <TextBlock x:Name="SearchHint" Text="Search, e.g. SimHub" Style="{StaticResource Muted}" FontSize="13"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button HorizontalAlignment="Left" Content="Browse for a file…" Click="Browse_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="AddButton" Content="Add" IsDefault="True" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="4" Margin="0,12,0,0">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="List_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:InstalledProgram}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Path, Converter={StaticResource PathToIcon}}" Width="24" Height="24" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LoadingText" Text="Looking for your programs…" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
