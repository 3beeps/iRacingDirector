<!-- Pride theme: deep purple base, rainbow stripe and switches, pink-to-blue primary buttons. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#120A1F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1030" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#28193F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3D2A5C" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4EFFB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AE9FC9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B266FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C98BFF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#3DDC84" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF4D6D" />

    <!-- Every stop keeps white text readable. -->
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D6246E" Offset="0" />
        <GradientStop Color="#9B3FC8" Offset="0.5" />
        <GradientStop Color="#3550E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E8448A" Offset="0" />
        <GradientStop Color="#B05BDB" Offset="0.5" />
        <GradientStop Color="#5068F0" Offset="1" />
    </LinearGradientBrush>

    <!-- Six-stripe rainbow flag. -->
    <LinearGradientBrush x:Key="SwitchOnBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E40303" Offset="0" />
        <GradientStop Color="#FF8C00" Offset="0.2" />
        <GradientStop Color="#FFED00" Offset="0.4" />
        <GradientStop Color="#008026" Offset="0.6" />
        <GradientStop Color="#24408E" Offset="0.8" />
        <GradientStop Color="#732982" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StripeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E40303" Offset="0" />
        <GradientStop Color="#E40303" Offset="0.1667" />
        <GradientStop Color="#FF8C00" Offset="0.1667" />
        <GradientStop Color="#FF8C00" Offset="0.3333" />
        <GradientStop Color="#FFED00" Offset="0.3333" />
        <GradientStop Color="#FFED00" Offset="0.5" />
        <GradientStop Color="#008026" Offset="0.5" />
        <GradientStop Color="#008026" Offset="0.6667" />
        <GradientStop Color="#24408E" Offset="0.6667" />
        <GradientStop Color="#24408E" Offset="0.8333" />
        <GradientStop Color="#732982" Offset="0.8333" />
        <GradientStop Color="#732982" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
