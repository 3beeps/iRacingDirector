<!-- Dark theme colors. Every theme file defines the same brush keys; Theme.xaml uses them via DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#0B1120" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1A2333" />
    <SolidColorBrush x:Key="BorderBrush" Color="#243042" />
    <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B98AC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B9BFF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="BadBrush" Color="#EF4444" />

    <!-- Primary buttons and the update banner (white text on top). -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5B9BFF" />
    <!-- Track of a switched-on toggle. -->
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#3B82F6" />
    <!-- Decorative stripe along the top of windows (hidden in this theme). -->
    <SolidColorBrush x:Key="StripeBrush" Color="Transparent" />
</ResourceDictionary>
